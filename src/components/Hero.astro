---
import { site } from '../data/site';

const hotspots = [
  { label: 'Klimatizácia', href: '#klimatizacie', x: 32.5, y: 44.4, align: 'top' },
  { label: 'Plynový kotol', href: '#servis-kotlov', x: 71.7, y: 77.8, align: 'right' },
  { label: 'Tepelné čerpadlo', href: '#klimatizacie', x: 9.2, y: 83.3, align: 'top' },
];

const points = ['Návrh podľa výpočtu tepelných strát', 'Presná cena písomne po obhliadke', 'Servis aj po montáži'];
---

<section class="hero" id="top">
  <div class="container hero__inner">
    <div class="hero__head">
      <span class="label" data-reveal>Galanta a {site.region}</span>
      <h1 data-reveal style="--d:.08s">Tepelné čerpadlá, klimatizácie a servis kotlov</h1>
    </div>

    <div class="hero__body">
      <p class="hero__lead" data-reveal style="--d:.16s">
        Navrhneme, namontujeme a spustíme vykurovanie, ktoré sedí na váš dom. A postaráme sa oň aj po rokoch.
      </p>

      <div class="hero__cta" data-reveal style="--d:.24s">
        <a href="#kontakt" class="btn">
          Dohodnúť obhliadku
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </a>
        <a href={site.phoneHref} class="btn btn--outline">{site.phone}</a>
      </div>

      <ul class="hero__points" data-reveal style="--d:.32s">
        {
          points.map((p) => (
            <li>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12l5 5 9-10" />
              </svg>
              {p}
            </li>
          ))
        }
      </ul>
    </div>

    <div class="house">
      <svg viewBox="20 80 760 450" role="img" aria-label="Rez rodinným domom s klimatizáciou, plynovým kotlom a tepelným čerpadlom">
        <defs>
          <linearGradient id="h-roof" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#5c635f" />
            <stop offset="1" stop-color="#454b47" />
          </linearGradient>
          <linearGradient id="h-sky" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#dfe7ea" />
            <stop offset="1" stop-color="#f2f5f5" />
          </linearGradient>
          <linearGradient id="h-white" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#ffffff" />
            <stop offset="1" stop-color="#e3e6e3" />
          </linearGradient>
          <linearGradient id="h-metal" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#e4e7e4" />
            <stop offset="1" stop-color="#b4b9b5" />
          </linearGradient>
          <linearGradient id="h-tank" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0" stop-color="#cfd3cf" />
            <stop offset=".45" stop-color="#ffffff" />
            <stop offset="1" stop-color="#c3c8c4" />
          </linearGradient>
          <linearGradient id="h-ground" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0" stop-color="#dcdfda" stop-opacity="0" />
            <stop offset=".12" stop-color="#dcdfda" />
            <stop offset=".88" stop-color="#dcdfda" />
            <stop offset="1" stop-color="#dcdfda" stop-opacity="0" />
          </linearGradient>
          <filter id="h-shadow" x="-20%" y="-20%" width="140%" height="160%">
            <feDropShadow dx="0" dy="3" stdDeviation="3" flood-color="#1f2421" flood-opacity=".22" />
          </filter>
        </defs>

        <!-- ground -->
        <g class="h-part" style="--i:0">
          <rect x="0" y="500" width="800" height="30" fill="url(#h-ground)" />
          <rect x="0" y="498" width="800" height="3" fill="url(#h-ground)" opacity=".9" />
          <ellipse cx="390" cy="503" rx="270" ry="7" fill="#1f2421" opacity=".12" />
        </g>

        <!-- tree -->
        <g class="h-part tree" style="--i:1">
          <rect x="694" y="420" width="10" height="80" fill="#7c817c" />
          <circle cx="699" cy="392" r="46" fill="#a9bba9" />
          <circle cx="672" cy="414" r="30" fill="#9db29e" />
          <circle cx="724" cy="410" r="32" fill="#93a994" />
        </g>

        <!-- chimney + roof -->
        <g class="h-part" style="--i:1">
          <rect x="558" y="158" width="28" height="60" fill="#8f9590" />
          <rect x="554" y="152" width="36" height="9" rx="1" fill="#6f7571" />
          <polygon points="150,248 390,100 630,248" fill="url(#h-roof)" />
          <polygon points="196,240 390,122 584,240" fill="#e4e6e2" />
          <polygon points="214,240 390,134 566,240" fill="#eef0ec" />
          <rect x="150" y="244" width="480" height="6" fill="#3d433f" />
        </g>

        <!-- walls (section cut) -->
        <g class="h-part" style="--i:2">
          <rect x="170" y="240" width="440" height="260" fill="#bcc1bb" />
          <rect x="182" y="252" width="250" height="120" fill="#eef0ed" />
          <rect x="444" y="252" width="154" height="120" fill="#ebedea" />
          <rect x="182" y="384" width="250" height="104" fill="#f1f2ef" />
          <rect x="444" y="384" width="154" height="104" fill="#e6e8e5" />
          <rect x="432" y="412" width="12" height="76" fill="#ebedea" />
          <!-- floors -->
          <rect x="182" y="366" width="416" height="6" fill="#d9d2c6" />
          <rect x="182" y="482" width="416" height="6" fill="#d9d2c6" />
        </g>

        <!-- furniture & windows -->
        <g class="h-part" style="--i:3">
          <!-- upstairs living -->
          <rect x="358" y="276" width="58" height="66" rx="2" fill="#fff" />
          <rect x="362" y="280" width="50" height="58" fill="url(#h-sky)" />
          <rect x="386" y="280" width="2" height="58" fill="#fff" />
          <rect x="204" y="336" width="128" height="30" rx="6" fill="#8b928d" />
          <rect x="204" y="324" width="128" height="18" rx="6" fill="#9ca29d" />
          <rect x="198" y="330" width="14" height="36" rx="5" fill="#7f8681" />
          <rect x="324" y="330" width="14" height="36" rx="5" fill="#7f8681" />
          <!-- bedroom -->
          <rect x="466" y="276" width="48" height="52" rx="2" fill="#fff" />
          <rect x="470" y="280" width="40" height="44" fill="url(#h-sky)" />
          <rect x="454" y="330" width="96" height="10" rx="3" fill="#a7ada8" />
          <rect x="454" y="340" width="96" height="26" rx="3" fill="#d4d8d4" />
          <rect x="456" y="334" width="26" height="9" rx="4" fill="#fff" />
          <!-- downstairs living -->
          <rect x="246" y="398" width="66" height="50" rx="2" fill="#fff" />
          <rect x="250" y="402" width="58" height="42" fill="url(#h-sky)" />
          <rect x="278" y="402" width="2" height="42" fill="#fff" />
          <g class="radiator">
            <rect x="244" y="456" width="70" height="22" rx="2" fill="url(#h-white)" stroke="#c9cdc9" />
            {[0, 1, 2, 3, 4, 5, 6, 7].map((i) => <rect x={250 + i * 8} y="459" width="2" height="16" fill="#d3d7d3" />)}
          </g>
          <path class="heat heat--1" d="M256 450c-4-6 4-10 0-16" />
          <path class="heat heat--2" d="M279 450c-4-6 4-10 0-16" />
          <path class="heat heat--3" d="M302 450c-4-6 4-10 0-16" />
          <rect x="350" y="446" width="76" height="36" rx="2" fill="#a0a6a1" />
          <rect x="348" y="442" width="80" height="6" rx="1" fill="#7f8681" />
          <rect x="360" y="454" width="24" height="22" rx="1" fill="#b3b8b3" />
          <rect x="390" y="454" width="24" height="22" rx="1" fill="#b3b8b3" />
        </g>

        <!-- utility room: hot water tank + pipes -->
        <g class="h-part" style="--i:4">
          <rect x="458" y="414" width="40" height="68" rx="10" fill="url(#h-tank)" filter="url(#h-shadow)" />
          <rect x="470" y="428" width="16" height="4" rx="2" fill="#9aa09b" />
          <path d="M498 440h20v-4h28" fill="none" stroke="#b8865b" stroke-width="3" />
          <path d="M498 470h30v-10" fill="none" stroke="#b8865b" stroke-width="3" />
          <path d="M552 464v18M562 464v18M572 464v18" stroke="#9aa09b" stroke-width="3" />
        </g>

        <!-- flue -->
        <g class="h-part" style="--i:4">
          <rect x="565" y="196" width="12" height="206" fill="#cfd3cf" />
          <rect x="565" y="196" width="4" height="206" fill="#e6e9e6" />
        </g>

        <!-- boiler -->
        <g class="h-part device device--boiler" style="--i:5">
          <rect x="540" y="400" width="50" height="64" rx="5" fill="url(#h-white)" filter="url(#h-shadow)" />
          <rect x="540" y="400" width="50" height="3" rx="1.5" fill="#fff" />
          <rect x="548" y="410" width="34" height="12" rx="2" fill="#2b302d" />
          <text x="565" y="419.5" text-anchor="middle" class="lcd">56°</text>
          <circle cx="552" cy="452" r="2.5" class="led" />
          <rect class="flame" x="574" y="446" width="8" height="10" rx="2" />
        </g>

        <!-- air conditioner indoor -->
        <g class="h-part device device--ac" style="--i:5">
          <rect x="198" y="266" width="138" height="32" rx="7" fill="url(#h-white)" filter="url(#h-shadow)" />
          <rect x="204" y="290" width="126" height="4" rx="2" fill="#cfd3cf" />
          <circle cx="322" cy="276" r="1.8" class="led" />
          <path class="air air--1" d="M214 304c10 14 4 30 14 44" />
          <path class="air air--2" d="M246 304c10 14 4 30 14 44" />
          <path class="air air--3" d="M278 304c10 14 4 30 14 44" />
          <path class="air air--4" d="M310 304c10 14 4 30 14 44" />
        </g>

        <!-- refrigerant line -->
        <g class="h-part" style="--i:5">
          <path d="M198 282H162V456H152" fill="none" stroke="#e7e9e6" stroke-width="7" stroke-linejoin="round" />
          <path d="M198 282H162V456H152" fill="none" stroke="#c9cdc9" stroke-width="1" stroke-linejoin="round" />
        </g>

        <!-- outdoor unit -->
        <g class="h-part device device--hp" style="--i:6">
          <ellipse cx="102" cy="501" rx="56" ry="4" fill="#1f2421" opacity=".18" />
          <rect x="62" y="490" width="8" height="10" fill="#7f8681" />
          <rect x="134" y="490" width="8" height="10" fill="#7f8681" />
          <rect x="54" y="426" width="98" height="66" rx="4" fill="url(#h-metal)" filter="url(#h-shadow)" />
          <rect x="54" y="426" width="98" height="3" rx="1.5" fill="#f4f5f4" />
          <circle cx="90" cy="459" r="26" fill="#3a403c" />
          <g class="fan">
            {[0, 90, 180, 270].map((r) => <path d="M90 459c-2-10 2-20 9-22 3 8 0 17-9 22z" fill="#8c938e" transform={`rotate(${r} 90 459)`} />)}
          </g>
          <circle cx="90" cy="459" r="26" fill="none" stroke="#c7cbc7" stroke-width="2" />
          <circle cx="90" cy="459" r="18" fill="none" stroke="#c7cbc7" stroke-width="1" opacity=".7" />
          <circle cx="90" cy="459" r="10" fill="none" stroke="#c7cbc7" stroke-width="1" opacity=".7" />
          <path d="M64 459h52M90 433v52" stroke="#c7cbc7" stroke-width="1" opacity=".7" />
          {[0, 1, 2, 3, 4, 5, 6].map((i) => <rect x="124" y={436 + i * 7} width="20" height="2.5" rx="1" fill="#a5aba6" />)}
        </g>

        <!-- chimney steam -->
        <g class="steam" aria-hidden="true">
          <circle cx="572" cy="140" r="7" />
          <circle cx="576" cy="140" r="9" />
          <circle cx="568" cy="140" r="6" />
        </g>
      </svg>

      {
        hotspots.map((h, i) => (
          <a href={h.href} class:list={['hotspot', `hotspot--${h.align}`]} style={`left:${h.x}%;top:${h.y}%;--i:${i}`}>
            <span class="hotspot__dot" aria-hidden="true" />
            <span class="hotspot__label">{h.label}</span>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .hero {
    padding-top: clamp(2.5rem, 6vw, 5rem);
    border-bottom: 1px solid var(--line);
  }

  .hero__inner {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 1.5rem 4rem;
    align-items: end;
  }

  h1 {
    margin-top: 0.8rem;
    font-size: clamp(2.3rem, 4.6vw, 3.8rem);
    line-height: 1.08;
    letter-spacing: -0.025em;
  }

  .hero__lead {
    font-size: 1.15rem;
    color: var(--muted);
    max-width: 44ch;
  }

  .hero__cta {
    margin-top: 2rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .hero__points {
    list-style: none;
    margin: 1.8rem 0 0;
    padding: 1.3rem 0 0;
    border-top: 1px solid var(--line);
    display: grid;
    gap: 0.45rem;
    font-weight: 600;
    font-size: 0.97rem;
  }

  .hero__points li {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .hero__points svg {
    width: 18px;
    color: var(--green);
    flex: none;
  }

  /* House illustration */
  .house {
    grid-column: 1 / -1;
    position: relative;
    width: min(60vw, 114svh);
    margin: clamp(1rem, 3vw, 2.5rem) 0 0 50%;
    translate: -50% 0;
  }

  .house svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .h-part {
    animation: part-in 1s var(--ease) both;
    animation-delay: calc(0.15s + var(--i) * 0.12s);
  }

  @keyframes part-in {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }

  .fan {
    transform-box: fill-box;
    transform-origin: center;
    animation: spin 1.6s linear infinite;
  }

  @keyframes spin {
    to {
      rotate: 360deg;
    }
  }

  .led {
    fill: #3fbf6a;
    animation: blink 2.4s ease-in-out infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0.35;
    }
  }

  .lcd {
    font-family: var(--font);
    font-size: 8px;
    font-weight: 700;
    fill: #8fe3a9;
  }

  .flame {
    fill: #f2a24a;
    transform-box: fill-box;
    transform-origin: bottom;
    animation: flicker 0.9s ease-in-out infinite alternate;
  }

  @keyframes flicker {
    to {
      transform: scaleY(0.7);
      fill: #f5c063;
    }
  }

  .air {
    fill: none;
    stroke: #9fc3d1;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-dasharray: 10 60;
    animation: air 2.4s linear infinite;
    opacity: 0.85;
  }

  .air--2 {
    animation-delay: -0.6s;
  }

  .air--3 {
    animation-delay: -1.2s;
  }

  .air--4 {
    animation-delay: -1.8s;
  }

  @keyframes air {
    from {
      stroke-dashoffset: 70;
    }
    to {
      stroke-dashoffset: 0;
    }
  }

  .heat {
    fill: none;
    stroke: #e3a46a;
    stroke-width: 1.6;
    stroke-linecap: round;
    animation: rise 2.8s ease-in-out infinite;
    opacity: 0;
  }

  .heat--2 {
    animation-delay: -0.9s;
  }

  .heat--3 {
    animation-delay: -1.8s;
  }

  @keyframes rise {
    0% {
      opacity: 0;
      transform: translateY(6px);
    }
    40% {
      opacity: 0.8;
    }
    100% {
      opacity: 0;
      transform: translateY(-10px);
    }
  }

  .steam circle {
    fill: #cfd4d0;
    transform-box: fill-box;
    transform-origin: center;
    animation: steam 4.5s ease-out infinite;
    opacity: 0;
  }

  .steam circle:nth-child(2) {
    animation-delay: -1.5s;
  }

  .steam circle:nth-child(3) {
    animation-delay: -3s;
  }

  @keyframes steam {
    0% {
      opacity: 0;
      transform: translate(0, 0) scale(0.6);
    }
    20% {
      opacity: 0.8;
    }
    100% {
      opacity: 0;
      transform: translate(14px, -60px) scale(2);
    }
  }

  .device {
    transition: filter 0.3s;
  }

  /* Hotspots */
  .hotspot {
    position: absolute;
    width: 18px;
    height: 18px;
    translate: -50% -50%;
    animation: part-in 0.8s var(--ease) both;
    animation-delay: calc(1.1s + var(--i) * 0.15s);
  }

  .hotspot__dot {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--green);
    box-shadow:
      0 0 0 3px rgba(255, 255, 255, 0.95),
      0 4px 10px rgba(31, 36, 33, 0.3);
  }

  .hotspot__dot::after {
    content: '';
    position: absolute;
    inset: -3px;
    border-radius: 50%;
    border: 2px solid var(--green);
    animation: ping 2.2s var(--ease) infinite;
  }

  @keyframes ping {
    from {
      transform: scale(1);
      opacity: 0.8;
    }
    to {
      transform: scale(2.2);
      opacity: 0;
    }
  }

  .hotspot__label {
    position: absolute;
    padding: 0.3rem 0.65rem;
    border-radius: 6px;
    background: var(--white);
    border: 1px solid var(--line);
    font-size: clamp(0.8rem, 1vw, 1rem);
    font-weight: 700;
    white-space: nowrap;
    box-shadow: 0 6px 16px -10px rgba(31, 36, 33, 0.5);
    transition:
      background 0.25s,
      color 0.25s,
      border-color 0.25s;
  }

  .hotspot--top .hotspot__label {
    bottom: calc(100% + 10px);
    left: 50%;
    translate: -50% 0;
  }

  .hotspot--right .hotspot__label {
    left: calc(100% + 10px);
    top: 50%;
    translate: 0 -50%;
  }

  .hotspot:hover .hotspot__label,
  .hotspot:focus-visible .hotspot__label {
    background: var(--green);
    border-color: var(--green);
    color: #fff;
  }

  @media (max-width: 960px) {
    .hero__inner {
      grid-template-columns: 1fr;
      align-items: start;
    }

    .house {
      width: 100vw;
    }
  }

  @media (max-width: 560px) {
    .hotspot {
      width: 14px;
      height: 14px;
    }

    .hotspot__label {
      font-size: 0.7rem;
      padding: 0.2rem 0.45rem;
    }
  }
</style>
