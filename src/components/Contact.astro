---
import { site } from '../data/site';
import { area, country } from '../data/slovakia-map';

// Map coordinates (px) in the 560x560 crop, see src/data/slovakia-map.ts
const home = { x: 309.5, y: 337.7 };

const towns = [
  { name: 'Sereď', x: 311.8, y: 297.9, align: 'end' },
  { name: 'Trnava', x: 270.2, y: 260.4, align: 'end' },
  { name: 'Hlohovec', x: 330.6, y: 240.5, align: 'start' },
  { name: 'Piešťany', x: 337.3, y: 170.7, align: 'start' },
  { name: 'Dunajská Streda', x: 278.6, y: 419.2, align: 'start' },
];

const landmarks = [
  { name: 'Bratislava', x: 138.4, y: 354.9 },
  { name: 'Nitra', x: 409, y: 289.5 },
];

const regionLabels = [
  { name: 'Trnavský kraj', x: 292, y: 476, active: true },
  { name: 'Bratislavský kraj', x: 160, y: 300 },
  { name: 'Trenčiansky kraj', x: 452, y: 120 },
  { name: 'Nitriansky kraj', x: 466, y: 396 },
];

const countries = [
  { name: 'Rakúsko', x: 40, y: 430 },
  { name: 'Maďarsko', x: 190, y: 540 },
  { name: 'Česko', x: 60, y: 40 },
];
---

<section class="section section--white contact" id="kontakt">
  <div class="container contact__inner">
    <div class="contact__copy">
      <span class="label" data-reveal>Kontakt</span>
      <h2 class="section-title" data-reveal style="--d:.08s">Dohodnime si obhliadku</h2>
      <p class="section-lead" data-reveal style="--d:.16s">
        Zavolajte alebo nám napíšte. Termín dohodneme telefonicky a prídeme k vám.
      </p>

      <a href={site.phoneHref} class="big-phone" data-reveal style="--d:.24s">
        <span>Telefón</span>
        {site.phone}
      </a>

      <dl class="info" data-reveal style="--d:.3s">
        <div>
          <dt>E-mail</dt>
          <dd class="email">
            <a href={`mailto:${site.email}`}>{site.email}</a>
            <button type="button" class="copy" data-copy={site.email}>Kopírovať</button>
          </dd>
        </div>
        <div>
          <dt>Adresa</dt>
          <dd>{site.street}, {site.city}</dd>
        </div>
        <div>
          <dt>Pôsobnosť</dt>
          <dd>Galanta a {site.region}</dd>
        </div>
      </dl>
    </div>

    <figure class="map" data-reveal style="--d:.15s">
      <svg viewBox="0 0 560 560" role="img" aria-label={`Mapa pôsobnosti: Galanta a ${site.region}`}>
        <defs>
          <pattern id="map-grid" width="28" height="28" patternUnits="userSpaceOnUse">
            <path d="M28 0H0V28" fill="none" stroke="#dde3e1" stroke-width="1" />
          </pattern>
        </defs>

        <rect width="560" height="560" fill="url(#map-grid)" />

        {
          Object.entries(area)
            .filter(([id]) => id !== 'TA')
            .map(([, d]) => <path class="region" d={d} />)
        }
        <path class="region region--active" d={area.TA} />

        {countries.map((c) => <text class="country" x={c.x} y={c.y}>{c.name}</text>)}
        {
          regionLabels.map((r) => (
            <text class:list={['region-name', { 'region-name--active': r.active }]} x={r.x} y={r.y} text-anchor="middle">
              {r.name}
            </text>
          ))
        }

        {
          landmarks.map((l) => (
            <g class="landmark">
              <circle cx={l.x} cy={l.y} r="4" />
              <text x={l.x} y={l.y - 10} text-anchor="middle">{l.name}</text>
            </g>
          ))
        }

        {
          towns.map((t, i) => (
            <g class="town" style={`--i:${i}`}>
              <path class="route" d={`M${home.x} ${home.y}L${t.x} ${t.y}`} pathLength="1" />
              <circle class="town__dot" cx={t.x} cy={t.y} r="5" />
              <text class="town__name" x={t.x + (t.align === 'end' ? -12 : 12)} y={t.y + 5} text-anchor={t.align}>
                {t.name}
              </text>
            </g>
          ))
        }

        <g class="home">
          <circle class="home__pulse" cx={home.x} cy={home.y} r="14" />
          <circle cx={home.x} cy={home.y} r="14" fill="var(--brand)" stroke="#fff" stroke-width="4" />
          <path d={`M${home.x - 7} ${home.y + 2}l7-6 7 6v6h-14z`} fill="#fff" />
          <rect x={home.x - 48} y={home.y + 24} width="96" height="26" rx="6" fill="var(--dark)" />
          <text class="home__name" x={home.x} y={home.y + 41.5} text-anchor="middle">Galanta</text>
        </g>

        <!-- locator: whole Slovakia -->
        <g class="locator" transform="translate(392 476)">
          <rect x="-10" y="-10" width="173" height="95" rx="8" />
          <g transform="scale(.36)">
            {Object.entries(country).map(([id, d]) => <path class:list={{ active: id === 'TA' }} d={d} />)}
          </g>
        </g>
      </svg>

      <figcaption>
        <strong>{site.name}</strong>
        <span>{site.street}, {site.city}</span>
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .contact {
    border-top: 1px solid var(--line);
  }

  .contact__inner {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 4.5rem;
    align-items: center;
  }

  .big-phone {
    display: inline-block;
    margin-top: 2.2rem;
    font-size: clamp(2rem, 4vw, 2.8rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.15;
    color: var(--brand);
    transition: color 0.25s;
  }

  .big-phone:hover {
    color: var(--brand-dark);
  }

  .big-phone span {
    display: block;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0;
    color: var(--muted);
  }

  .info {
    margin: 2.2rem 0 0;
    display: grid;
    gap: 1.1rem;
  }

  .info div {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: 1rem;
    padding-bottom: 1.1rem;
    border-bottom: 1px solid var(--line);
  }

  .info dt {
    font-weight: 700;
    font-size: 0.92rem;
    color: var(--muted);
  }

  .info dd {
    margin: 0;
    font-weight: 600;
  }

  .info a {
    border-bottom: 1px solid var(--line-strong);
    transition: border-color 0.25s;
  }

  .info a:hover {
    border-color: var(--brand);
  }

  .email {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.8rem;
  }

  .copy {
    padding: 0.3rem 0.7rem;
    border-radius: 6px;
    border: 1px solid var(--line-strong);
    background: var(--white);
    color: var(--text);
    font: inherit;
    font-size: 0.82rem;
    font-weight: 700;
    cursor: pointer;
    transition:
      border-color 0.2s,
      color 0.2s;
  }

  .copy:hover {
    border-color: var(--brand);
    color: var(--brand);
  }

  .copy:focus-visible {
    outline: 2px solid var(--brand);
    outline-offset: 2px;
  }

  /* Service area map */
  .map {
    position: relative;
    margin: 0;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--bg);
  }

  .map svg {
    width: 100%;
    height: auto;
  }

  .region {
    fill: var(--white);
    stroke: var(--line-strong);
    stroke-width: 1.5;
    stroke-linejoin: round;
  }

  .region--active {
    fill: var(--brand-soft);
    stroke: var(--brand);
    stroke-width: 2.5;
  }

  .country,
  .region-name {
    font-family: var(--font);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    fill: #9aa4a2;
  }

  .country {
    letter-spacing: 0.2em;
    fill: #b0b8b6;
  }

  .region-name--active {
    font-size: 12px;
    fill: var(--brand);
  }

  .landmark circle {
    fill: var(--line-strong);
  }

  .landmark text {
    font-family: var(--font);
    font-size: 13px;
    font-weight: 700;
    fill: var(--muted);
  }

  .locator rect {
    fill: var(--white);
    stroke: var(--line);
  }

  .locator path {
    fill: var(--bg-2);
    stroke: var(--white);
    stroke-width: 2;
  }

  .locator path.active {
    fill: var(--brand);
  }

  .route {
    fill: none;
    stroke: var(--brand);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-dasharray: 1;
    opacity: 0.55;
  }

  .town__dot {
    fill: var(--white);
    stroke: var(--brand);
    stroke-width: 3;
  }

  .town__name {
    font-family: var(--font);
    font-size: 15px;
    font-weight: 700;
    fill: var(--text);
    paint-order: stroke;
    stroke: var(--bg);
    stroke-width: 5px;
    stroke-linejoin: round;
  }

  .home__name {
    font-family: var(--font);
    font-size: 14px;
    font-weight: 800;
    fill: #fff;
  }

  .home__pulse {
    fill: var(--brand);
    transform-box: fill-box;
    transform-origin: center;
    animation: pulse 2.4s var(--ease) infinite;
  }

  @keyframes pulse {
    from {
      transform: scale(1);
      opacity: 0.45;
    }
    to {
      transform: scale(3.2);
      opacity: 0;
    }
  }

  :global(.js) .map .route {
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 1.2s var(--ease);
    transition-delay: calc(0.5s + var(--i) * 0.15s);
  }

  :global(.js) .map .town__dot,
  :global(.js) .map .town__name {
    opacity: 0;
    transition: opacity 0.6s var(--ease);
    transition-delay: calc(1.1s + var(--i) * 0.15s);
  }

  :global(.js) .map.is-visible .route {
    stroke-dashoffset: 0;
  }

  :global(.js) .map.is-visible .town__dot,
  :global(.js) .map.is-visible .town__name {
    opacity: 1;
  }

  figcaption {
    position: absolute;
    left: 14px;
    top: 14px;
    display: grid;
    padding: 0.6rem 0.85rem;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.92);
    border: 1px solid var(--line);
    font-size: 0.85rem;
    line-height: 1.4;
  }

  figcaption span {
    color: var(--muted);
    font-weight: 600;
  }

  @media (max-width: 960px) {
    .contact__inner {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
  }

  @media (max-width: 560px) {
    .info div {
      grid-template-columns: 1fr;
      gap: 0.2rem;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('.copy').forEach((button) => {
    const label = button.textContent;

    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copy ?? '');
        button.textContent = 'Skopírované';
      } catch {
        button.textContent = 'Nepodarilo sa';
      }
      setTimeout(() => (button.textContent = label), 2000);
    });
  });
</script>
