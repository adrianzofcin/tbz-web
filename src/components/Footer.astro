---
import { nav, site } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <div class="footer__grid">
      <div>
        <strong>{site.legalName}</strong>
        <p>{site.street}<br />{site.city}</p>
        <p>IČO: {site.ico}</p>
      </div>
      <div>
        <strong>Kontakt</strong>
        <p><a href={site.phoneHref}>{site.phone}</a></p>
        <p><a href={`mailto:${site.email}`}>{site.email}</a></p>
      </div>
      <nav aria-label="Pätička">
        <strong>Navigácia</strong>
        <ul>
          {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        </ul>
      </nav>
    </div>

    <div class="footer__bottom">
      <span>© {year} {site.legalName}</span>
      <span>{site.owner}, {site.ownerRole}</span>
    </div>
  </div>
</footer>

<style>
  .footer {
    --slant: clamp(1.5rem, 3vw, 3rem);
    position: relative;
    padding-block: calc(3.5rem + var(--slant)) 2rem;
    background: var(--dark);
    color: #b3bcba;
    font-size: 0.95rem;
  }

  /* Slanted top edge (Protherm brochure motif), filled with the contact section's white */
  .footer::before {
    content: '';
    position: absolute;
    inset: -1px 0 auto;
    height: calc(var(--slant) + 1px);
    background: var(--white);
    clip-path: polygon(0 0, 100% 0, 0 100%);
  }

  .footer__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .footer strong {
    display: block;
    color: #fff;
    margin-bottom: 0.7rem;
  }

  .footer p + p {
    margin-top: 0.3rem;
  }

  .footer ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.25rem;
  }

  .footer a {
    transition: color 0.2s;
  }

  .footer a:hover {
    color: #fff;
  }

  .footer__bottom {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    padding-top: 1.5rem;
    font-size: 0.85rem;
  }

  @media (max-width: 760px) {
    .footer__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
