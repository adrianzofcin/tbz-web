---
const faqs = [
  {
    q: 'Bude tepelné čerpadlo hlučné?',
    a: 'Závisí to od modelu a umiestnenia vonkajšej jednotky. Miesto vyberáme tak, aby bolo v pohode pre vás aj pre susedov.',
  },
  {
    q: 'Vykúri tepelné čerpadlo dom aj v mraze?',
    a: 'Áno, čerpadlo kúri aj v mraze. V chladnom počasí síce stúpa spotreba elektriny, preto návrh robíme s ohľadom na najchladnejšie dni v roku.',
  },
  {
    q: 'Dá sa na tepelné čerpadlo získať dotácia?',
    a: 'Na tepelné čerpadlo môže byť možné čerpať dotáciu z programu Zelená domácnostiam — za podmienok programu. Aktuálne informácie nájdete na zelenadomacnostiam.sk, radi vám s tým poradíme pri obhliadke.',
  },
  {
    q: 'Ako často treba servisovať plynový kotol?',
    a: 'Odporúčame raz ročne, ideálne pred začiatkom vykurovacej sezóny. Pravidelná prehliadka predchádza poruchám, šetrí plyn a predlžuje životnosť kotla.',
  },
  {
    q: 'Servisujete aj zariadenia, ktoré ste nemontovali?',
    a: 'Áno. Kontroly a opravy robíme aj na starších systémoch a zariadeniach od iných montážnych firiem.',
  },
];
---

<section class="section faq" id="otazky">
  <div class="container faq__inner">
    <div>
      <span class="label" data-reveal>Časté otázky</span>
      <h2 class="section-title" data-reveal style="--d:.1s">Na čo sa nás často pýtate</h2>
      <p class="section-lead" data-reveal style="--d:.2s">
        Nenašli ste odpoveď? Zavolajte nám — radi poradíme aj bez záväzkov.
      </p>
    </div>

    <div class="faq__list">
      {
        faqs.map((f, i) => (
          <details name="faq" data-reveal style={`--d:${i * 0.07}s`} open={i === 0}>
            <summary>
              {f.q}
              <span class="faq__icon" aria-hidden="true" />
            </summary>
            <p>{f.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq__inner {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: 4rem;
  }

  .faq__list {
    display: grid;
    gap: 0.8rem;
  }

  details {
    border-radius: var(--radius);
    background: var(--white);
    box-shadow: 0 0 0 1px var(--line);
    transition:
      box-shadow 0.4s var(--ease),
      background 0.4s;
    overflow: hidden;
  }

  details[open] {
    box-shadow:
      0 0 0 1px var(--line-strong),
      0 18px 40px -30px rgba(31, 36, 33, 0.35);
  }

  details::details-content {
    block-size: 0;
    overflow: hidden;
    transition:
      block-size 0.5s var(--ease),
      content-visibility 0.5s allow-discrete;
  }

  details[open]::details-content {
    block-size: auto;
  }

  summary {
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    padding: 1.5rem 1.8rem;
    font-size: 1.1rem;
    font-weight: 600;
    cursor: pointer;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .faq__icon {
    position: relative;
    flex: none;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--bg);
    transition:
      transform 0.5s var(--ease),
      background 0.4s;
  }

  .faq__icon::before,
  .faq__icon::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 12px;
    height: 2px;
    margin: -1px 0 0 -6px;
    background: currentColor;
    border-radius: 2px;
  }

  .faq__icon::after {
    transform: rotate(90deg);
    transition: transform 0.5s var(--ease);
  }

  details[open] .faq__icon {
    background: var(--brand);
    color: #fff;
    transform: rotate(180deg);
  }

  details[open] .faq__icon::after {
    transform: rotate(0deg);
  }

  details p {
    padding: 0 1.8rem 1.6rem;
    color: var(--muted);
    max-width: 62ch;
  }

  @media (max-width: 960px) {
    .faq__inner {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }
</style>
