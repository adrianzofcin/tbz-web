---
const steps = [
  {
    title: 'Obhliadka a výpočet',
    text: 'Pozrieme sa na dom, súčasné vykurovanie a miesto pre vonkajšiu jednotku. Vypočítame tepelné straty.',
  },
  {
    title: 'Návrh a cena písomne',
    text: 'Navrhneme výkon a rozsah prác. Cenu dostanete písomne, aby ste sa mohli v pokoji rozhodnúť.',
  },
  {
    title: 'Montáž',
    text: 'Osadíme zariadenie a napojíme ho na vykurovanie v dome. Čisto a v dohodnutom termíne.',
  },
  {
    title: 'Spustenie a servis',
    text: 'Systém spustíme, ukážeme vám ovládanie a ostávame k dispozícii pre pravidelný servis.',
  },
];
---

<section class="section section--white process" id="postup">
  <div class="container">
    <span class="label" data-reveal>Ako to prebieha</span>
    <h2 class="section-title" data-reveal style="--d:.08s">Od obhliadky po spustenie v štyroch krokoch</h2>

    <ol class="steps">
      <span class="steps__rail" aria-hidden="true"><span class="steps__fill"></span></span>
      {
        steps.map((s, i) => (
          <li class="step" data-reveal style={`--d:${i * 0.1}s`}>
            <span class="step__no">{i + 1}</span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .process {
    border-top: 1px solid var(--line);
  }

  .steps {
    position: relative;
    list-style: none;
    margin: 3.5rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
  }

  .steps__rail {
    position: absolute;
    top: 22px;
    left: 22px;
    right: 22px;
    height: 2px;
    background: var(--line);
  }

  .steps__fill {
    position: absolute;
    inset: 0;
    background: var(--brand);
    transform-origin: left;
    transform: scaleX(0);
    transition: transform 1.8s var(--ease) 0.3s;
  }

  .steps:has(.is-visible) .steps__fill {
    transform: scaleX(1);
  }

  .step {
    position: relative;
  }

  .step__no {
    position: relative;
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: var(--white);
    border: 2px solid var(--brand);
    color: var(--brand);
    font-weight: 700;
    margin-bottom: 1.4rem;
  }

  .step h3 {
    font-size: 1.2rem;
  }

  .step p {
    margin-top: 0.5rem;
    color: var(--muted);
    font-size: 0.97rem;
  }

  @media (max-width: 900px) {
    .steps {
      grid-template-columns: 1fr;
      gap: 2rem;
      padding-left: 4rem;
    }

    .steps__rail {
      top: 22px;
      bottom: 22px;
      left: 22px;
      right: auto;
      width: 2px;
      height: auto;
    }

    .steps__fill {
      transform-origin: top;
      transform: scaleY(0);
    }

    .steps:has(.is-visible) .steps__fill {
      transform: scaleY(1);
    }

    .step__no {
      position: absolute;
      left: -4rem;
      top: -0.3rem;
    }
  }
</style>
