---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Services from '../components/Services.astro';
import AirConditioning from '../components/AirConditioning.astro';
import BoilerService from '../components/BoilerService.astro';
import Benefits from '../components/Benefits.astro';
import Process from '../components/Process.astro';
import Faq from '../components/Faq.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="TZB PRO SERVIS — Tepelné čerpadlá, klimatizácie a servis kotlov | Galanta"
  description="Návrh, montáž a servis tepelných čerpadiel a klimatizácií, servis plynových kotlov. Galanta a Trnavský kraj."
>
  <Header />
  <main>
    <Hero />
    <Services />
    <AirConditioning />
    <BoilerService />
    <Benefits />
    <Process />
    <Faq />
    <Contact />
  </main>
  <Footer />
</Layout>
